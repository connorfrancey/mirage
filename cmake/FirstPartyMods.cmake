# Native first-party mods (Mirage step 9): a mod in mods/<id>/ with a CMakeLists.txt is built here, as its own DLL,
# against the public API only, and embedded in the menu's DLL as a resource; runtime/firstparty writes it out next to
# the mod's other files at startup.
#
#   mods/<id>/CMakeLists.txt:   mirage_native_mod(<id> SOURCES a.cpp b.cpp [LIBS nlohmann_json::nlohmann_json])
#   mods/<id>/mod.toml:         entry = "<id>.dll"
#
# What a native mod may use: api/ (mirage/api.h, mirage/mirage.hpp), its own files and the header-only libraries listed
# in MIRAGE_MOD_ALLOWED_LIBS. Never the menu's sources or include paths: what a mod needs from the menu goes into the
# API (cmake/EmbedMods.cmake also refuses a quoted #include of anything else).

# The SDK is public (sdk/, api/mirage/sdk.hpp). imgui (+ imgui_filebrowser): only with MirageApi imgui_context, which
# refuses a mod built with another ImGui version (api/mirage/imgui.hpp).
set(MIRAGE_MOD_ALLOWED_LIBS nlohmann_json::nlohmann_json mirage::sdk fmt::fmt unordered_dense magic_enum::magic_enum
    imgui imgui_filebrowser)

function(mirage_native_mod id)
  cmake_parse_arguments(PARSE_ARGV 1 M "" "" "SOURCES;LIBS")
  foreach(lib IN LISTS M_LIBS)
    if(NOT lib IN_LIST MIRAGE_MOD_ALLOWED_LIBS)
      message(FATAL_ERROR "mods/${id}: links ${lib}, which a first-party mod may not (allowed: ${MIRAGE_MOD_ALLOWED_LIBS})")
    endif()
  endforeach()
  set(target mirage_mod_${id})
  add_library(${target} SHARED ${M_SOURCES})
  target_include_directories(${target} PRIVATE ${CMAKE_SOURCE_DIR}/api ${CMAKE_CURRENT_SOURCE_DIR})
  target_compile_features(${target} PRIVATE cxx_std_20)
  target_compile_definitions(${target} PRIVATE WIN32_LEAN_AND_MEAN NOMINMAX)
  target_link_libraries(${target} PRIVATE ${M_LIBS})
  set_target_properties(${target} PROPERTIES
          PREFIX ""
          OUTPUT_NAME ${id}
          MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>"
          RUNTIME_OUTPUT_DIRECTORY ${MIRAGE_NATIVE_MODS_DIR}/${id}
          LIBRARY_OUTPUT_DIRECTORY ${MIRAGE_NATIVE_MODS_DIR}/${id})
  if(MSVC)
    target_compile_options(${target} PRIVATE /W4 /permissive- /utf-8)
  endif()
  set_property(GLOBAL APPEND PROPERTY MIRAGE_NATIVE_MODS ${id})
endfunction()

# Builds every native first-party mod and embeds them in `menu_target`: an .rc with each DLL as RCDATA (numbered from
# 1000), and the list of them for EmbedMods.cmake (BINS: "<id>/<id>.dll@<resource id>;...").
function(mirage_native_mods menu_target out_bins)
  set(MIRAGE_NATIVE_MODS_DIR ${CMAKE_BINARY_DIR}/firstparty-bin PARENT_SCOPE)
  set(MIRAGE_NATIVE_MODS_DIR ${CMAKE_BINARY_DIR}/firstparty-bin)
  file(GLOB _lists CONFIGURE_DEPENDS ${CMAKE_SOURCE_DIR}/mods/*/CMakeLists.txt)
  list(SORT _lists)
  foreach(list_file IN LISTS _lists)
    get_filename_component(dir ${list_file} DIRECTORY)
    get_filename_component(id ${dir} NAME)
    add_subdirectory(${dir} ${CMAKE_BINARY_DIR}/firstparty/${id})
  endforeach()
  get_property(mods GLOBAL PROPERTY MIRAGE_NATIVE_MODS)
  set(rc "// Generated by cmake/FirstPartyMods.cmake: the native first-party mods, embedded as RCDATA\n")
  set(bins "")
  set(files "")
  set(n 1000)
  foreach(id IN LISTS mods)
    set(dll ${MIRAGE_NATIVE_MODS_DIR}/${id}/${id}.dll)
    string(APPEND rc "${n} RCDATA \"${dll}\"\n")
    list(APPEND bins "${id}/${id}.dll@${n}")
    list(APPEND files ${dll})
    add_dependencies(${menu_target} mirage_mod_${id})
    math(EXPR n "${n} + 1")
  endforeach()
  if(mods)
    set(rc_file ${CMAKE_BINARY_DIR}/generated/firstparty_mods.rc)
    file(WRITE ${rc_file}.tmp "${rc}")
    file(COPY_FILE ${rc_file}.tmp ${rc_file} ONLY_IF_DIFFERENT)
    file(REMOVE ${rc_file}.tmp)
    target_sources(${menu_target} PRIVATE ${rc_file})
    set_source_files_properties(${rc_file} PROPERTIES OBJECT_DEPENDS "${files}")
  endif()
  set(${out_bins} "${bins}" PARENT_SCOPE)
endfunction()
