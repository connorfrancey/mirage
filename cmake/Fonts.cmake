# The menu's fonts as byte arrays in a generated .cpp (loader/src/font.h), so nothing has to be installed next to the DLL.
# Both come with Dear ImGui (misc/fonts), Apache License 2.0:
#   Roboto Medium     the menu
#   Cousine Regular   monospace: the console (features/misc/console.cpp)
# and Font Awesome 6 Free Solid (SIL OFL 1.1), downloaded once (pinned and hash-checked, cmake/Versions.cmake): the icons,
# merged into the menu font and named by IconFontCppHeaders (ICON_FA_* in IconsFontAwesome6.h).
# The script editor's font, JetBrains Mono Nerd Font (loader/fonts/, 2.5 MB), is a Win32 resource (901) instead: a byte
# array that size is slow for CMake to write and for the compiler to read.
# A font that isn't there is empty in the generated file: ImGui's built-in font is used in its place.

# The C array `name` with the bytes of `file`, and its size, into `data_var` / `size_var`
function(_mirage_font_array file name label data_var size_var)
  if(EXISTS "${file}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${file}")
    file(READ "${file}" _hex HEX)
    string(LENGTH "${_hex}" _len)
    math(EXPR _size "${_len} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
    # 32 bytes per line: one line of 160 KB would be hard on editors and the compiler
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],){4})"
           "\\1\n    " _bytes "${_bytes}")
    set(${data_var} "const unsigned char ${name}[] = {\n    ${_bytes}0};\n" PARENT_SCOPE)
    set(${size_var} "${_size}" PARENT_SCOPE)
    message(STATUS "Font: ${label} (${_size} bytes)")
  else()
    set(${data_var} "const unsigned char ${name}[] = {0};\n" PARENT_SCOPE)
    set(${size_var} "0" PARENT_SCOPE)
    message(STATUS "Font: ${file} not found, ImGui's built-in font is used for it")
  endif()
endfunction()

# Font Awesome's solid font, into the CPM cache when there is one (else the build folder); "" if it can't be downloaded
function(_mirage_icon_font out_var)
  if(CPM_SOURCE_CACHE)
    set(_dir "${CPM_SOURCE_CACHE}/fontawesome/${FONTAWESOME_VERSION}")
  else()
    set(_dir "${CMAKE_BINARY_DIR}/_deps/fontawesome-${FONTAWESOME_VERSION}")
  endif()
  set(_file "${_dir}/fa-solid-900.ttf")
  if(NOT EXISTS "${_file}")
    file(DOWNLOAD "https://raw.githubusercontent.com/FortAwesome/Font-Awesome/${FONTAWESOME_VERSION}/webfonts/fa-solid-900.ttf"
         "${_file}.part" EXPECTED_HASH SHA256=${FONTAWESOME_SOLID_SHA256} STATUS _status)
    list(GET _status 0 _code)
    if(_code EQUAL 0)
      file(RENAME "${_file}.part" "${_file}")
    else()
      file(REMOVE "${_file}.part")
      message(WARNING "Font Awesome ${FONTAWESOME_VERSION} couldn't be downloaded (${_status}): the menu has no icons")
    endif()
  endif()
  set(${out_var} "${_file}" PARENT_SCOPE)
endfunction()

function(mirage_embed_font out_var)
  set(_out "${CMAKE_BINARY_DIR}/generated/mirage_font.cpp")
  _mirage_font_array("${imgui_SOURCE_DIR}/misc/fonts/Roboto-Medium.ttf" kMenu "Roboto Medium" _menu _menuSize)
  _mirage_font_array("${imgui_SOURCE_DIR}/misc/fonts/Cousine-Regular.ttf" kMono "Cousine Regular" _mono _monoSize)
  _mirage_icon_font(_iconFile)
  _mirage_font_array("${_iconFile}" kIcons "Font Awesome 6 Free Solid" _icons _iconsSize)

  set(_editorFont "${CMAKE_SOURCE_DIR}/loader/fonts/JetBrainsMonoNerdFont-Regular.ttf")
  set(_rc "${CMAKE_BINARY_DIR}/generated/mirage_fonts.rc")
  if(EXISTS "${_editorFont}")
    set(_rcText "// Generated by cmake/Fonts.cmake: the script editor's font
901 RCDATA \"${_editorFont}\"
")
  else()
    set(_rcText "// Generated by cmake/Fonts.cmake: no script editor font in this checkout
")
  endif()
  file(WRITE "${_rc}.tmp" "${_rcText}")
  file(COPY_FILE "${_rc}.tmp" "${_rc}" ONLY_IF_DIFFERENT)
  file(REMOVE "${_rc}.tmp")
  set(${out_var}_rc "${_rc}" PARENT_SCOPE)

  set(_content "// Generated by cmake/Fonts.cmake: do not edit.
#include \"font.h\"

#include <windows.h>

namespace font {
namespace {
${_menu}
${_mono}
${_icons}} // namespace

const unsigned char* MenuData() { return kMenu; }
std::size_t MenuSize() { return ${_menuSize}; }
const unsigned char* MonoData() { return kMono; }
std::size_t MonoSize() { return ${_monoSize}; }
const unsigned char* IconData() { return kIcons; }
std::size_t IconSize() { return ${_iconsSize}; }

// Resource 901 of this DLL (the module this function is in)
static const unsigned char* EditorResource(std::size_t* size)
{
    HMODULE self = nullptr;
    GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
                       reinterpret_cast<LPCWSTR>(&EditorResource), &self);
    HRSRC r = self ? FindResourceW(self, MAKEINTRESOURCEW(901), MAKEINTRESOURCEW(10)) : nullptr;   // RT_RCDATA
    HGLOBAL h = r ? LoadResource(self, r) : nullptr;
    *size = r && h ? SizeofResource(self, r) : 0;
    return h ? static_cast<const unsigned char*>(LockResource(h)) : nullptr;
}
const unsigned char* EditorData() { std::size_t n; return EditorResource(&n); }
std::size_t EditorSize() { std::size_t n; EditorResource(&n); return n; }

} // namespace font
")
  # Only rewritten when it changed, so a reconfigure doesn't rebuild it
  if(EXISTS "${_out}")
    file(READ "${_out}" _old)
  endif()
  if(NOT "${_old}" STREQUAL "${_content}")
    file(WRITE "${_out}" "${_content}")
  endif()
  set(${out_var} "${_out}" PARENT_SCOPE)
endfunction()
