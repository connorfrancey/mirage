# ======================================================================================================================
# Embed Crashdump
# ======================================================================================================================

# The minidump helper (loader/crashdump/), embedded as resource 900: the crash reporter writes it next to the DLL
# (MIRAGE_GAME only)
add_subdirectory(loader/crashdump)
set(_crashdump_exe ${CMAKE_BINARY_DIR}/crashdump/mirage_crashdump.exe)
set(_crashdump_rc ${CMAKE_BINARY_DIR}/generated/crashdump.rc)
file(WRITE ${_crashdump_rc}.tmp "// Generated by cmake/generation/EmbedCrashdump.cmake: the minidump helper
900 RCDATA \"${_crashdump_exe}\"
")
file(COPY_FILE ${_crashdump_rc}.tmp ${_crashdump_rc} ONLY_IF_DIFFERENT)
file(REMOVE ${_crashdump_rc}.tmp)
target_sources(${PROJECT_NAME} PRIVATE ${_crashdump_rc})
set_source_files_properties(${_crashdump_rc} PROPERTIES OBJECT_DEPENDS ${_crashdump_exe})
add_dependencies(${PROJECT_NAME} mirage_crashdump)
