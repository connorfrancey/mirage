*.patch -text
*.sh text eol=lf
*.bat text eol=crlf
# setup.cmd is a cmd + bash polyglot: bash needs LF (cmd copes, see the comment at its top)
setup.cmd text eol=lf
# The Mirage SDK: written by mirage_sdkgen (mirage sdk), collapsed in diffs
sdk/** linguist-generated=true
# Model files: a converted model (.mmesh) holds a hash of its source's bytes, which line-ending conversion would change
*.obj -text
*.mtl -text
*.gltf -text
